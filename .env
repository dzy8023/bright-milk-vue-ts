# 平台本地运行端口号
VITE_PORT = 8848

# 是否隐藏首页 隐藏 true 不隐藏 false （勿删除，VITE_HIDE_HOME只需在.env文件配置）
VITE_HIDE_HOME = false
# 基础请求路径
VITE_BASE_API=/api

# mock地址
VITE_MOCK_BASE_API=/mock

# 网络请求延迟时间
VITE_BASE_API_TIMEOUT=60000

# 失败重试次数
VITE_BASE_API_RETRY=5

# 失败重试时间
VITE_BASE_API_RETRY_DELAY=3000

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH=/
